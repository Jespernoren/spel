#!/bin/sh
# A-065 lager 4: sekvensreglerna kollas före varje commit
# inkorg 58 (A-113): masterfilen story.js – ordningen kollas och manuset skrivs
node verktyg/story-koll.mjs || { echo "story-koll stoppade committen (se ovan)"; exit 1; }
node verktyg/story-manus.mjs > /dev/null && git add verktyg/story-manus.md
node verktyg/lint-story.mjs || { echo "lint-story stoppade committen (se ovan)"; exit 1; }
node verktyg/lint-sekvens.mjs || { echo "lint-sekvens stoppade committen (se ovan)"; exit 1; }
# A-067: ändras balans.js räknas ekonomin om – DYR DAG, BILLIG DAG och PLATT STEG stoppar committen
if git diff --cached --name-only | grep -q 'printa-hem/balans.js'; then node verktyg/ekonomi.mjs > /dev/null || { node verktyg/ekonomi.mjs | tail -5; echo "ekonomi.mjs stoppade committen"; exit 1; }; fi
# A-080: inga vägar runt Regissören (toast, röst, kamera direkt)
node verktyg/lint-regissor.mjs || { echo "lint-regissor stoppade committen (se ovan)"; exit 1; }
node verktyg/lint-roster.mjs || { echo "lint-roster stoppade committen (se ovan)"; exit 1; }
node verktyg/lint-spelord.mjs || { echo "lint-spelord stoppade committen (se ovan)"; exit 1; }
node verktyg/lint-okant-ord.mjs || { echo "lint-okant-ord stoppade committen (se ovan)"; exit 1; }   # inkorg 36 (A-095)
node verktyg/lint-dagnummer.mjs || { echo "lint-dagnummer stoppade committen (se ovan)"; exit 1; }   # inkorg 54 (A-109)
# inkorg 62 (A-117): röktest mot index.html som ES-modul (som Pages laddar den) – den bundlade filen döljer fel som "Cannot access 'S' before initialization"
if git diff --cached --name-only | grep -qE '^(spel/printa-hem|delat)/'; then node verktyg/roktest-modul.mjs || { echo "röktestet stoppade committen: spelet startar inte som modul"; exit 1; }; fi
