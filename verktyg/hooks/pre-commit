#!/bin/sh
# A-065 lager 4: sekvensreglerna kollas före varje commit
node verktyg/lint-sekvens.mjs || { echo "lint-sekvens stoppade committen (se ovan)"; exit 1; }
# A-067: ändras balans.js räknas ekonomin om – DYR DAG, BILLIG DAG och PLATT STEG stoppar committen
if git diff --cached --name-only | grep -q 'printa-hem/balans.js'; then node verktyg/ekonomi.mjs > /dev/null || { node verktyg/ekonomi.mjs | tail -5; echo "ekonomi.mjs stoppade committen"; exit 1; }; fi
# A-080: inga vägar runt Regissören (toast, röst, kamera direkt)
node verktyg/lint-regissor.mjs || { echo "lint-regissor stoppade committen (se ovan)"; exit 1; }
node verktyg/lint-roster.mjs || { echo "lint-roster stoppade committen (se ovan)"; exit 1; }
node verktyg/lint-spelord.mjs || { echo "lint-spelord stoppade committen (se ovan)"; exit 1; }
